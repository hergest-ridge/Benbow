-- v1 -> v2 (7.21 B3, ADR-050): the trackers' records beside calendars and events. A build before this one kept none of
-- the kinds it didn't know, so the cursor goes back to the start and the next sync pulls every record again (LWW keeps
-- that safe; records with pending local ops stay as they are).
CREATE TABLE tracker_record (
    kind TEXT NOT NULL,
    id TEXT NOT NULL,
    fields TEXT NOT NULL DEFAULT '{}',
    field_clocks TEXT NOT NULL DEFAULT '{}',
    owner TEXT,
    day TEXT,
    end_day TEXT,
    deleted INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (kind, id)
);

CREATE INDEX tracker_record_by_owner ON tracker_record(kind, owner, day);

UPDATE kv SET value = '0' WHERE key = 'sync.cursor';
