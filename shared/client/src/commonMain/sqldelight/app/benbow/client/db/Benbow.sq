-- Local cache + client-owned data (docs/sync.md#client-local-state).
-- The outbox is the only data the client owns: a row is deleted only after the server acknowledged it (data-safety S5).

CREATE TABLE entry (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    day TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    head_rev TEXT,
    body TEXT NOT NULL,
    -- Derived from body on every write, so lists never parse documents.
    title TEXT NOT NULL DEFAULT '',
    preview TEXT NOT NULL DEFAULT '',
    -- A note's card on the board (CardPreview as JSON, ADR-040); '' until made.
    card TEXT NOT NULL DEFAULT '',
    conflict_heads TEXT NOT NULL DEFAULT '[]',
    fields TEXT NOT NULL DEFAULT '{}',
    updated_at INTEGER NOT NULL,
    -- HLC of each field value, so a re-push after a server restore keeps last-writer-wins correct.
    field_clocks TEXT NOT NULL DEFAULT '{}',
    -- AttachmentState by attachment id (LWW per link), plus what lists show without parsing it.
    attachments TEXT NOT NULL DEFAULT '{}',
    media_count INTEGER NOT NULL DEFAULT 0,
    cover TEXT,
    -- A comment's entry (the "parent" field), kept as a column so threads and counts use an index.
    parent_id TEXT,
    -- Where the entry lives (the "space" field, ADR-040): null for the journal, 'board' for a note on the board.
    space TEXT
);

CREATE INDEX entry_by_parent ON entry(parent_id);

CREATE INDEX entry_by_space ON entry(space);

-- Every place of the journal (feed, days, calendar, Home, look-backs, stats, tags, search) reads this view, never
-- `entry`, so a note on the board (or in a space a later app knows) can't show there (ADR-040). An entry deleted for
-- good (the field "purged", set only by the server, ADR-041) shows nowhere, the trash included.
CREATE VIEW journal_entry AS SELECT * FROM entry WHERE space IS NULL AND json_extract(fields, '$.purged') IS NOT 'true';

CREATE VIEW board_entry AS SELECT * FROM entry WHERE space = 'board' AND json_extract(fields, '$.purged') IS NOT 'true';

-- Media files on this device, by SHA-256. A captured file stays until the server confirmed it;
-- downloaded ones are a cache (docs/data-safety.md#client-side-safety).
CREATE TABLE media (
    sha256 TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    size INTEGER NOT NULL,
    mime TEXT NOT NULL,
    origin TEXT NOT NULL, -- captured | downloaded
    uploaded INTEGER NOT NULL DEFAULT 0,
    name TEXT,
    captured_at INTEGER,
    last_access_at INTEGER NOT NULL,
    uploaded_at INTEGER
);

-- One row per attachment link of an entry (ADR-041): the library, the trash's media and the device's estimates read
-- it, never parsing entry.attachments per row. The triggers below make it from entry.attachments in the same statement
-- as every write of it, so no write path can leave it behind; a value they can't read gives no row and never fails the
-- write. The entry's day, space and trash are joined from `entry` (which also wakes the queries reading both).
-- Regenerable from `entry`: not client-owned data.
CREATE TABLE attachment_ref (
    entry_id TEXT NOT NULL,
    attachment_id TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    kind TEXT NOT NULL,
    mime TEXT NOT NULL,
    size INTEGER NOT NULL,
    name TEXT,
    width INTEGER,
    height INTEGER,
    duration_ms INTEGER,
    captured_at INTEGER,
    preview_sha256 TEXT,
    caption TEXT,
    position REAL NOT NULL,
    present INTEGER NOT NULL,
    purged INTEGER NOT NULL,
    -- When the link last changed (its HLC's wall time): when it was taken off, for the trash.
    changed_at INTEGER,
    PRIMARY KEY (entry_id, attachment_id)
);

CREATE INDEX attachment_ref_by_sha ON attachment_ref(sha256);

CREATE TRIGGER attachment_ref_insert AFTER INSERT ON entry BEGIN
    DELETE FROM attachment_ref WHERE entry_id = new.id;
    INSERT OR IGNORE INTO attachment_ref
    SELECT e.id, a.key, json_extract(a.value, '$.meta.sha256'), coalesce(json_extract(a.value, '$.meta.kind'), 'file'),
        coalesce(json_extract(a.value, '$.meta.mime'), 'application/octet-stream'), coalesce(json_extract(a.value, '$.meta.size'), 0),
        json_extract(a.value, '$.meta.name'), json_extract(a.value, '$.meta.width'), json_extract(a.value, '$.meta.height'),
        json_extract(a.value, '$.meta.duration_ms'), json_extract(a.value, '$.meta.captured_at'),
        json_extract(a.value, '$.meta.preview_sha256'), json_extract(a.value, '$.caption'),
        coalesce(json_extract(a.value, '$.position'), 0),
        json_type(a.value, '$.present') IS NOT 'false', json_type(a.value, '$.purged') IS 'true',
        CAST(json_extract(a.value, '$.hlc.wall') AS INTEGER)
    FROM entry AS e, json_each(CASE WHEN json_valid(e.attachments) THEN e.attachments ELSE '{}' END) AS a
    WHERE e.id = new.id AND a.type = 'object' AND json_type(a.value, '$.meta.sha256') = 'text';
END;

CREATE TRIGGER attachment_ref_update AFTER UPDATE OF attachments ON entry WHEN new.attachments IS NOT old.attachments BEGIN
    DELETE FROM attachment_ref WHERE entry_id = new.id;
    INSERT OR IGNORE INTO attachment_ref
    SELECT e.id, a.key, json_extract(a.value, '$.meta.sha256'), coalesce(json_extract(a.value, '$.meta.kind'), 'file'),
        coalesce(json_extract(a.value, '$.meta.mime'), 'application/octet-stream'), coalesce(json_extract(a.value, '$.meta.size'), 0),
        json_extract(a.value, '$.meta.name'), json_extract(a.value, '$.meta.width'), json_extract(a.value, '$.meta.height'),
        json_extract(a.value, '$.meta.duration_ms'), json_extract(a.value, '$.meta.captured_at'),
        json_extract(a.value, '$.meta.preview_sha256'), json_extract(a.value, '$.caption'),
        coalesce(json_extract(a.value, '$.position'), 0),
        json_type(a.value, '$.present') IS NOT 'false', json_type(a.value, '$.purged') IS 'true',
        CAST(json_extract(a.value, '$.hlc.wall') AS INTEGER)
    FROM entry AS e, json_each(CASE WHEN json_valid(e.attachments) THEN e.attachments ELSE '{}' END) AS a
    WHERE e.id = new.id AND a.type = 'object' AND json_type(a.value, '$.meta.sha256') = 'text';
END;

CREATE TRIGGER attachment_ref_delete AFTER DELETE ON entry BEGIN
    DELETE FROM attachment_ref WHERE entry_id = old.id;
END;

CREATE INDEX entry_by_day ON entry(day, created_at);

CREATE TABLE draft (
    entry_id TEXT NOT NULL PRIMARY KEY,
    body TEXT NOT NULL,
    base_rev TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    op_id TEXT NOT NULL UNIQUE,
    entry_id TEXT NOT NULL,
    op TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    state TEXT NOT NULL DEFAULT 'pending',
    last_error TEXT
);

CREATE INDEX outbox_by_entry ON outbox(entry_id, state);

-- Full-text search over everything on the device: title, all text, tags (FTS4: Android's SQLite has no FTS5).
-- unicode61 folds case and diacritics, so "елка" finds "ёлка". Rebuilt when SearchIndex.VERSION changes.
CREATE VIRTUAL TABLE entry_search USING fts4(entry_id, title, body, tags, notindexed=entry_id, tokenize=unicode61);

CREATE TABLE kv (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectEntry:
SELECT * FROM entry WHERE id = ?;

-- Trash is the LWW field "deleted" (JournalRepository.TRASH_FIELD).
journal:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
ORDER BY day DESC, created_at;

entriesForDay:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE day = ? AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
ORDER BY created_at;

-- The journal's trash; the board's notes have their own part of it (boardTrash, ADR-040).
trash:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE json_extract(fields, '$.deleted') IS 'true'
ORDER BY updated_at DESC;

upsertEntry:
INSERT INTO entry(id, kind, day, created_at, head_rev, body, title, preview, card, conflict_heads, fields, updated_at, field_clocks, attachments, media_count, cover)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    kind = excluded.kind,
    day = excluded.day,
    head_rev = excluded.head_rev,
    body = excluded.body,
    title = excluded.title,
    preview = excluded.preview,
    card = excluded.card,
    conflict_heads = excluded.conflict_heads,
    fields = excluded.fields,
    updated_at = excluded.updated_at,
    field_clocks = excluded.field_clocks,
    attachments = excluded.attachments,
    media_count = excluded.media_count,
    cover = excluded.cover;

-- Everything a device knows, for reconciliation after a server restore.
allEntries:
SELECT id, kind, day, created_at, head_rev, body, fields, field_clocks, attachments FROM entry;

-- Everything but app registries, oldest first: the archive export.
exportEntries:
SELECT id, kind, day, created_at, head_rev, body, conflict_heads, fields, field_clocks, attachments FROM entry
WHERE kind != 'system' AND json_extract(fields, '$.purged') IS NOT 'true' ORDER BY day, created_at;

-- :m1..:m4 are one word each ("stem OR word*"), :rest the words after them; built by SearchIndex.terms, never raw
-- input. One MATCH per word keeps OR unambiguous in both FTS query syntaxes. Null filters are off. A tag filter
-- (:tagged = 1) takes the tag's key and the keys of the tags merged into it (ADR-032).
search:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind != 'system'
  AND (:m1 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m1))
  AND (:m2 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m2))
  AND (:m3 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m3))
  AND (:m4 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m4))
  AND (:rest IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :rest))
  AND (:tagged = 0 OR id IN (SELECT tagged.id FROM entry AS tagged, json_each(tagged.fields) AS t WHERE t.key IN :tagKeys AND t.value IS NOT NULL))
  AND (:favorites = 0 OR json_extract(fields, '$.favorite') = 'true')
  AND (:withMedia = 0 OR media_count > 0)
ORDER BY day DESC, created_at DESC
LIMIT 300;

-- Home (4.2) -------------------------------------------------------------------------------

pinned:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE json_extract(fields, '$.pinned') = 'true' AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
ORDER BY updated_at DESC;

withDrafts:
SELECT e.id, e.day, e.created_at, e.title, e.preview, e.conflict_heads, e.media_count, e.cover, e.fields FROM journal_entry e
JOIN draft d ON d.entry_id = e.id
WHERE json_extract(e.fields, '$.deleted') IS NOT 'true'
ORDER BY d.updated_at DESC;

-- Same month and day in earlier years (:monthDay = "-10-13").
onThisDay:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE substr(day, 5) = :monthDay AND day < :today AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
ORDER BY day DESC, created_at;

favoritesUpTo:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE json_extract(fields, '$.favorite') = 'true' AND day <= :lastDay AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
ORDER BY day;

-- Days with writing: reminders (and pre-7.3a events) aren't writing.
daysWritten:
SELECT COUNT(DISTINCT day) FROM journal_entry
WHERE (day BETWEEN :fromDay AND :toDay) AND json_extract(fields, '$.deleted') IS NOT 'true'
  AND kind NOT IN ('system', 'event', 'reminder');

-- Home's stats (7.11 H4): each entry of the days with its fields and attachments, and the journal's first day.
statsEntries:
SELECT day, fields, attachments FROM journal_entry
WHERE (day BETWEEN :fromDay AND :toDay) AND json_extract(fields, '$.deleted') IS NOT 'true'
  AND kind NOT IN ('comment', 'system', 'event', 'reminder');

firstDay:
SELECT MIN(day) AS first FROM journal_entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder');

-- Feed (ADR-036): every post's place, newest first, without its text. `marks` holds only what Бережно goes by:
-- the fields veil, veil_until and tag:<id> (VEIL_FIELD, VEIL_UNTIL_FIELD, TAG_PREFIX); {"":null} when there are none.
feedIndex:
SELECT e.id, e.day, e.created_at, e.media_count, json_group_object(coalesce(f.key, ''), f.value) AS marks
FROM journal_entry AS e LEFT JOIN json_each(e.fields) AS f
    ON f.value IS NOT NULL AND (f.key IN ('veil', 'veil_until') OR substr(f.key, 1, 4) = 'tag:')
WHERE json_extract(e.fields, '$.deleted') IS NOT 'true' AND e.kind NOT IN ('comment', 'system', 'event', 'reminder')
GROUP BY e.id
ORDER BY e.day DESC, e.created_at DESC, e.id DESC;

-- The feed's posts in full, a window of the index at a time, with bodies to show notes in full.
feedItems:
SELECT id, kind, day, created_at, title, preview, body, conflict_heads, media_count, cover, fields, attachments,
    (SELECT COUNT(*) FROM entry c WHERE c.parent_id = entry.id AND c.kind = 'comment' AND json_extract(c.fields, '$.deleted') IS NOT 'true') AS comments
FROM entry
WHERE id IN :ids;

-- Comments (4.3): entries of kind "comment" with a parent, oldest first like a chat.
commentsOf:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields, body, attachments FROM entry
WHERE parent_id = ? AND kind = 'comment' AND json_extract(fields, '$.deleted') IS NOT 'true'
ORDER BY created_at;

commentCount:
SELECT COUNT(*) FROM entry WHERE parent_id = ? AND kind = 'comment' AND json_extract(fields, '$.deleted') IS NOT 'true';

-- The day and order an entry shows at, from its "when" field (Moments).
moveEntry:
UPDATE entry SET day = ?, created_at = ? WHERE id = ?;

updateParent:
UPDATE entry SET parent_id = ? WHERE id = ?;

updateSpace:
UPDATE entry SET space = ? WHERE id = ?;

-- The board's notes in the trash, the latest first.
boardTrash:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM board_entry
WHERE json_extract(fields, '$.deleted') IS 'true'
ORDER BY updated_at DESC;

-- Words on the board (K5), its archive too; the same terms as the journal's search (SearchIndex.terms). Types, colors
-- and tags are picked in code.
boardSearch:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields, card, attachments FROM board_entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
  AND (:m1 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m1))
  AND (:m2 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m2))
  AND (:m3 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m3))
  AND (:m4 IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :m4))
  AND (:rest IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :rest));

-- The board (ADR-040): its notes, the archive included, in no order (BoardRank sorts them in code).
boardNotes:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields, card, attachments FROM board_entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder');

-- Calendar (5.1) ---------------------------------------------------------------------------

-- Бережно (ADR-031): entries put off until a day that has come, not answered yet; oldest first (the Home card).
returned:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM journal_entry
WHERE json_extract(fields, '$.veil_until') <= :today AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind != 'system'
ORDER BY json_extract(fields, '$.veil_until'), day;

-- A calendar span's entries (moods and Бережно's marks are read in code, where the rules apply).
dayEntries:
SELECT day, fields FROM journal_entry
WHERE (day BETWEEN :fromDay AND :toDay) AND json_extract(fields, '$.deleted') IS NOT 'true'
  AND kind NOT IN ('comment', 'system', 'event', 'reminder');

-- Every day the calendar grid has a dot for (dayEntries' kinds), newest first: the calendar's overview (7.14).
entryDays:
SELECT DISTINCT day FROM journal_entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event', 'reminder')
ORDER BY day DESC;

-- Events made before 7.3a (kind "event", the text is the title): moved once to the calendar's own file (ADR-027).
journalEvents:
SELECT id, day, body, fields FROM entry
WHERE kind = 'event' AND json_extract(fields, '$.deleted') IS NOT 'true';

-- Reminders (5.2): kind "reminder", text = message, fields at = "YYYY-MM-DDTHH:MM", repeat = daily|weekly, done.
reminders:
SELECT id, title, json_extract(fields, '$.at') AS at, json_extract(fields, '$.repeat') AS repeat, json_extract(fields, '$.done') AS done
FROM entry
WHERE kind = 'reminder' AND json_extract(fields, '$.deleted') IS NOT 'true'
ORDER BY at;

-- Tags in use by key (`tag:<id>`, ADR-032) and the name entries hold, which may differ in case between entries.
tagCounts:
SELECT json_each.key AS key, json_each.value AS name, COUNT(*) AS uses
FROM journal_entry AS entry, json_each(entry.fields)
WHERE json_each.key LIKE 'tag:%' AND json_each.value IS NOT NULL AND json_extract(entry.fields, '$.deleted') IS NOT 'true' AND entry.kind != 'system'
GROUP BY json_each.key, json_each.value;

-- Whether any entry, in the trash or not, has or had this tag (the field may be null: taken off).
tagKeyInUse:
SELECT 1 FROM entry, json_each(entry.fields) WHERE json_each.key = :key LIMIT 1;

-- The name entries hold for a tag most often: what a tag from before ids is called when it gets a name of its own.
tagNameOnEntries:
SELECT json_each.value FROM entry, json_each(entry.fields)
WHERE json_each.key = :key AND json_each.value IS NOT NULL
GROUP BY json_each.value ORDER BY COUNT(*) DESC, json_each.value LIMIT 1;

-- Entries that carry a tag, to index them again when it reads differently.
entriesWithTag:
SELECT DISTINCT entry.id FROM entry, json_each(entry.fields) WHERE json_each.key = :key AND json_each.value IS NOT NULL;

indexEntry:
INSERT INTO entry_search(entry_id, title, body, tags) VALUES (?, ?, ?, ?);

unindexEntry:
DELETE FROM entry_search WHERE entry_id = ?;

clearIndex:
DELETE FROM entry_search;

allEntryIds:
SELECT id FROM entry;

updateAttachments:
UPDATE entry SET attachments = ?, media_count = ?, cover = ?, updated_at = ? WHERE id = ?;

-- Every attachment link as attachment_ref holds it (ADR-041).
attachmentRefs:
SELECT * FROM attachment_ref ORDER BY entry_id, position, attachment_id;

-- The media library (ADR-041): every attachment shown in an entry, the newest entries first, each with the entry it
-- belongs to (a comment's own entry: its day, its place and what Бережно goes by). The trash keeps its own, comments on
-- an entry in the trash with it.
libraryItems:
SELECT r.entry_id, r.attachment_id, r.sha256, r.kind, r.mime, r.size, r.name, r.width, r.height, r.duration_ms,
    r.captured_at, r.preview_sha256, r.caption, r.position, r.changed_at,
    coalesce(p.id, e.id) AS post_id, coalesce(p.day, e.day) AS day, coalesce(p.space, e.space) AS space,
    coalesce(p.fields, e.fields) AS post_fields, e.fields
FROM attachment_ref AS r
JOIN entry AS e ON e.id = r.entry_id
LEFT JOIN entry AS p ON p.id = e.parent_id
WHERE r.present = 1 AND r.purged = 0 AND e.kind != 'system'
    AND json_extract(e.fields, '$.deleted') IS NOT 'true'
    AND (p.id IS NULL OR json_extract(p.fields, '$.deleted') IS NOT 'true')
ORDER BY coalesce(p.day, e.day) DESC, coalesce(p.created_at, e.created_at) DESC, e.created_at, r.position, r.attachment_id;

-- The trash's «Вложения» (ADR-041): attachments taken off entries that aren't in the trash themselves (those wait with
-- their entries), the latest taken off first; the same columns as libraryItems.
takenOff:
SELECT r.entry_id, r.attachment_id, r.sha256, r.kind, r.mime, r.size, r.name, r.width, r.height, r.duration_ms,
    r.captured_at, r.preview_sha256, r.caption, r.position, r.changed_at,
    coalesce(p.id, e.id) AS post_id, coalesce(p.day, e.day) AS day, coalesce(p.space, e.space) AS space,
    coalesce(p.fields, e.fields) AS post_fields, e.fields
FROM attachment_ref AS r
JOIN entry AS e ON e.id = r.entry_id
LEFT JOIN entry AS p ON p.id = e.parent_id
WHERE r.present = 0 AND r.purged = 0 AND e.kind != 'system'
    AND json_extract(e.fields, '$.deleted') IS NOT 'true'
    AND (p.id IS NULL OR json_extract(p.fields, '$.deleted') IS NOT 'true')
ORDER BY r.changed_at DESC, r.entry_id, r.attachment_id;

-- Everything waiting in the trash (ADR-041, «Место»): attachments taken off, and those of entries in the trash or of
-- comments on them, the heaviest first; the same columns as libraryItems.
trashItems:
SELECT r.entry_id, r.attachment_id, r.sha256, r.kind, r.mime, r.size, r.name, r.width, r.height, r.duration_ms,
    r.captured_at, r.preview_sha256, r.caption, r.position, r.changed_at,
    coalesce(p.id, e.id) AS post_id, coalesce(p.day, e.day) AS day, coalesce(p.space, e.space) AS space,
    coalesce(p.fields, e.fields) AS post_fields, e.fields
FROM attachment_ref AS r
JOIN entry AS e ON e.id = r.entry_id
LEFT JOIN entry AS p ON p.id = e.parent_id
WHERE r.purged = 0 AND e.kind != 'system'
    AND (r.present = 0 OR json_extract(e.fields, '$.deleted') IS 'true' OR json_extract(p.fields, '$.deleted') IS 'true')
ORDER BY r.size DESC, r.entry_id, r.attachment_id;

-- Every file held by an entry in the trash or by a comment on one (taken off or not): what the trash weighs.
trashFiles:
SELECT e.id, e.parent_id, r.sha256, r.size
FROM attachment_ref AS r
JOIN entry AS e ON e.id = r.entry_id
LEFT JOIN entry AS p ON p.id = e.parent_id
WHERE r.purged = 0 AND (json_extract(e.fields, '$.deleted') IS 'true' OR json_extract(p.fields, '$.deleted') IS 'true');

-- Since when each entry is in the trash: the wall time of its trash field's clock.
trashSince:
SELECT id, CAST(json_extract(field_clocks, '$.deleted.wall') AS INTEGER) AS since, updated_at FROM entry
WHERE json_extract(fields, '$.deleted') IS 'true';

putMedia:
INSERT INTO media(sha256, path, size, mime, origin, uploaded, name, captured_at, last_access_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(sha256) DO UPDATE SET
    origin = CASE WHEN media.origin = 'captured' THEN 'captured' ELSE excluded.origin END,
    last_access_at = excluded.last_access_at;

selectMedia:
SELECT * FROM media WHERE sha256 = ?;

touchMedia:
UPDATE media SET last_access_at = ? WHERE sha256 = ?;

pendingUploads:
SELECT * FROM media WHERE origin = 'captured' AND uploaded = 0 ORDER BY last_access_at;

pendingUploadCount:
SELECT COUNT(*) FROM media WHERE origin = 'captured' AND uploaded = 0;

markUploaded:
UPDATE media SET uploaded = 1, uploaded_at = ? WHERE sha256 = ?;

-- Files the server already holds, least recently viewed first: downloads, and captured files confirmed
-- before :settledBefore (the server's backup job has had time to copy them). Small files (previews) stay.
evictable:
SELECT sha256, path, size FROM media
WHERE size >= :minSize AND (origin = 'downloaded' OR (origin = 'captured' AND uploaded = 1 AND uploaded_at < :settledBefore))
ORDER BY last_access_at;

-- Files here that only purged links name, and no text (ADR-041): deleted for good on the server, so here too. A link
-- taken off or in the trash still holds its file, and so does any word of a live entry or a draft.
purgedMedia:
SELECT m.sha256, m.path, m.size FROM media AS m
WHERE EXISTS (SELECT 1 FROM attachment_ref AS r WHERE (r.sha256 = m.sha256 OR r.preview_sha256 = m.sha256) AND r.purged = 1)
    AND NOT EXISTS (SELECT 1 FROM attachment_ref AS r WHERE (r.sha256 = m.sha256 OR r.preview_sha256 = m.sha256) AND r.purged = 0)
    AND NOT EXISTS (SELECT 1 FROM entry AS e WHERE instr(e.body, m.sha256) > 0 AND json_extract(e.fields, '$.purged') IS NOT 'true')
    AND NOT EXISTS (SELECT 1 FROM draft AS d WHERE instr(d.body, m.sha256) > 0);

-- What this device keeps («Место», ADR-041): every file, and what evictable would let go now.
mediaUsage:
SELECT coalesce(SUM(size), 0) AS total,
    coalesce(SUM(CASE WHEN size >= :minSize AND (origin = 'downloaded' OR (origin = 'captured' AND uploaded = 1 AND uploaded_at < :settledBefore))
        THEN size ELSE 0 END), 0) AS freeable
FROM media;

forgetMedia:
DELETE FROM media WHERE sha256 = ? AND (origin = 'downloaded' OR uploaded = 1);

-- A file deleted for good on the server (ADR-041, purgedMedia): the one way a captured file leaves before the server
-- confirmed it, by the owner's own purge.
forgetPurged:
DELETE FROM media WHERE sha256 = ?;

-- After a server restore the server may lack files it once confirmed; the uploader asks again (dedup makes it cheap).
recheckUploads:
UPDATE media SET uploaded = 0 WHERE origin = 'captured';

updateHead:
UPDATE entry SET head_rev = ?, body = ?, title = ?, preview = ?, card = ?, updated_at = ? WHERE id = ?;

-- The local title and preview made again from the body (JournalRepository.prepareSummaries); nothing else changes.
updateSummary:
UPDATE entry SET title = ?, preview = ?, card = ? WHERE id = ?;

clearConflicts:
UPDATE entry SET conflict_heads = '[]' WHERE id = ?;

draftCount:
SELECT COUNT(*) FROM draft;

deleteAllEntries:
DELETE FROM entry;

updateFields:
UPDATE entry SET fields = ?, field_clocks = ?, updated_at = ? WHERE id = ?;

selectDraft:
SELECT * FROM draft WHERE entry_id = ?;

upsertDraft:
INSERT INTO draft(entry_id, body, base_rev, updated_at) VALUES (?, ?, ?, ?)
ON CONFLICT(entry_id) DO UPDATE SET body = excluded.body, updated_at = excluded.updated_at;

deleteDraft:
DELETE FROM draft WHERE entry_id = ?;

allDrafts:
SELECT entry_id FROM draft;

rejectedCount:
SELECT COUNT(*) FROM outbox WHERE state = 'rejected';

enqueue:
INSERT INTO outbox(op_id, entry_id, op, created_at) VALUES (?, ?, ?, ?);

pendingOps:
SELECT * FROM outbox WHERE state = 'pending' ORDER BY seq LIMIT ?;

acknowledge:
DELETE FROM outbox WHERE op_id = ? AND state = 'pending';

reject:
UPDATE outbox SET state = 'rejected', last_error = ? WHERE op_id = ?;

pendingCountFor:
SELECT COUNT(*) FROM outbox WHERE entry_id = ? AND state = 'pending';

pendingCount:
SELECT COUNT(*) FROM outbox WHERE state = 'pending';

rejectedOps:
SELECT * FROM outbox WHERE state = 'rejected' ORDER BY seq;

retryRejected:
UPDATE outbox SET state = 'pending', last_error = NULL WHERE state = 'rejected';

getValue:
SELECT value FROM kv WHERE key = ?;

putValue:
INSERT INTO kv(key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value;

deleteValue:
DELETE FROM kv WHERE key = ?;
