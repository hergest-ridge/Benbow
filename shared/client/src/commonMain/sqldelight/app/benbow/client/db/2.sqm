-- v2 -> v3 (3.2): attachments of entries and media files on the device.
ALTER TABLE entry ADD COLUMN attachments TEXT NOT NULL DEFAULT '{}';
ALTER TABLE entry ADD COLUMN media_count INTEGER NOT NULL DEFAULT 0;
ALTER TABLE entry ADD COLUMN cover TEXT;

CREATE TABLE media (
    sha256 TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    size INTEGER NOT NULL,
    mime TEXT NOT NULL,
    origin TEXT NOT NULL,
    uploaded INTEGER NOT NULL DEFAULT 0,
    name TEXT,
    captured_at INTEGER,
    last_access_at INTEGER NOT NULL
);
