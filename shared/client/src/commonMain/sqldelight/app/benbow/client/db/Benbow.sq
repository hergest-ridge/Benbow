-- Local cache + client-owned data (docs/sync.md#client-local-state).
-- The outbox is the only data the client owns: a row is deleted only after the server acknowledged it (data-safety S5).

CREATE TABLE entry (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    day TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    head_rev TEXT,
    body TEXT NOT NULL,
    -- Derived from body on every write, so lists never parse documents.
    title TEXT NOT NULL DEFAULT '',
    preview TEXT NOT NULL DEFAULT '',
    conflict_heads TEXT NOT NULL DEFAULT '[]',
    fields TEXT NOT NULL DEFAULT '{}',
    updated_at INTEGER NOT NULL,
    -- HLC of each field value, so a re-push after a server restore keeps last-writer-wins correct.
    field_clocks TEXT NOT NULL DEFAULT '{}',
    -- AttachmentState by attachment id (LWW per link), plus what lists show without parsing it.
    attachments TEXT NOT NULL DEFAULT '{}',
    media_count INTEGER NOT NULL DEFAULT 0,
    cover TEXT,
    -- A comment's entry (the "parent" field), kept as a column so threads and counts use an index.
    parent_id TEXT
);

CREATE INDEX entry_by_parent ON entry(parent_id);

-- Media files on this device, by SHA-256. A captured file stays until the server confirmed it;
-- downloaded ones are a cache (docs/data-safety.md#client-side-safety).
CREATE TABLE media (
    sha256 TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    size INTEGER NOT NULL,
    mime TEXT NOT NULL,
    origin TEXT NOT NULL, -- captured | downloaded
    uploaded INTEGER NOT NULL DEFAULT 0,
    name TEXT,
    captured_at INTEGER,
    last_access_at INTEGER NOT NULL,
    uploaded_at INTEGER
);

CREATE INDEX entry_by_day ON entry(day, created_at);

CREATE TABLE draft (
    entry_id TEXT NOT NULL PRIMARY KEY,
    body TEXT NOT NULL,
    base_rev TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    op_id TEXT NOT NULL UNIQUE,
    entry_id TEXT NOT NULL,
    op TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    state TEXT NOT NULL DEFAULT 'pending',
    last_error TEXT
);

CREATE INDEX outbox_by_entry ON outbox(entry_id, state);

-- Full-text search over everything on the device: title, all text, tags (FTS4: Android's SQLite has no FTS5).
-- unicode61 folds case and diacritics, so "елка" finds "ёлка". Rebuilt when SearchIndex.VERSION changes.
CREATE VIRTUAL TABLE entry_search USING fts4(entry_id, title, body, tags, notindexed=entry_id, tokenize=unicode61);

CREATE TABLE kv (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectEntry:
SELECT * FROM entry WHERE id = ?;

-- Trash is the LWW field "deleted" (JournalRepository.TRASH_FIELD).
journal:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event')
ORDER BY day DESC, created_at;

entriesForDay:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE day = ? AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event')
ORDER BY created_at;

trash:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE json_extract(fields, '$.deleted') IS 'true'
ORDER BY updated_at DESC;

upsertEntry:
INSERT INTO entry(id, kind, day, created_at, head_rev, body, title, preview, conflict_heads, fields, updated_at, field_clocks, attachments, media_count, cover)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    kind = excluded.kind,
    day = excluded.day,
    head_rev = excluded.head_rev,
    body = excluded.body,
    title = excluded.title,
    preview = excluded.preview,
    conflict_heads = excluded.conflict_heads,
    fields = excluded.fields,
    updated_at = excluded.updated_at,
    field_clocks = excluded.field_clocks,
    attachments = excluded.attachments,
    media_count = excluded.media_count,
    cover = excluded.cover;

-- Everything a device knows, for reconciliation after a server restore.
allEntries:
SELECT id, kind, day, created_at, head_rev, body, fields, field_clocks, attachments FROM entry;

-- :match is an FTS query built by SearchIndex.match (never raw user input); null filters are off.
search:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind != 'system'
  AND (:match IS NULL OR id IN (SELECT entry_id FROM entry_search WHERE entry_search MATCH :match))
  AND (:tagPath IS NULL OR json_extract(fields, :tagPath) IS NOT NULL)
  AND (:favorites = 0 OR json_extract(fields, '$.favorite') = 'true')
  AND (:withMedia = 0 OR media_count > 0)
ORDER BY day DESC, created_at DESC
LIMIT 300;

-- Home (4.2) -------------------------------------------------------------------------------

pinned:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE json_extract(fields, '$.pinned') = 'true' AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event')
ORDER BY updated_at DESC;

withDrafts:
SELECT e.id, e.day, e.created_at, e.title, e.preview, e.conflict_heads, e.media_count, e.cover, e.fields FROM entry e
JOIN draft d ON d.entry_id = e.id
WHERE json_extract(e.fields, '$.deleted') IS NOT 'true'
ORDER BY d.updated_at DESC;

-- Same month and day in earlier years (:monthDay = "-10-13").
onThisDay:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE substr(day, 5) = :monthDay AND day < :today AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event')
ORDER BY day DESC, created_at;

favoritesUpTo:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields FROM entry
WHERE json_extract(fields, '$.favorite') = 'true' AND day <= :lastDay AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event')
ORDER BY day;

daysWritten:
SELECT COUNT(DISTINCT day) FROM entry
WHERE (day BETWEEN :fromDay AND :toDay) AND json_extract(fields, '$.deleted') IS NOT 'true' AND kind != 'system';

-- Feed: newest first (the list is drawn bottom-up), with bodies to show notes in full.
feed:
SELECT id, kind, day, created_at, title, preview, body, conflict_heads, media_count, cover, fields,
    (SELECT COUNT(*) FROM entry c WHERE c.parent_id = entry.id AND c.kind = 'comment' AND json_extract(c.fields, '$.deleted') IS NOT 'true') AS comments
FROM entry
WHERE json_extract(fields, '$.deleted') IS NOT 'true' AND kind NOT IN ('comment', 'system', 'event')
ORDER BY day DESC, created_at DESC
LIMIT :limit;

-- Comments (4.3): entries of kind "comment" with a parent, oldest first like a chat.
commentsOf:
SELECT id, day, created_at, title, preview, conflict_heads, media_count, cover, fields, body FROM entry
WHERE parent_id = ? AND kind = 'comment' AND json_extract(fields, '$.deleted') IS NOT 'true'
ORDER BY created_at;

commentCount:
SELECT COUNT(*) FROM entry WHERE parent_id = ? AND kind = 'comment' AND json_extract(fields, '$.deleted') IS NOT 'true';

updateParent:
UPDATE entry SET parent_id = ? WHERE id = ?;

-- Calendar (5.1) ---------------------------------------------------------------------------

-- Per day in a range: how many entries and the average mood (null when none was set).
monthDays:
SELECT day, COUNT(*) AS entries, AVG(CAST(json_extract(fields, '$.mood') AS INTEGER)) AS mood FROM entry
WHERE (day BETWEEN :fromDay AND :toDay) AND json_extract(fields, '$.deleted') IS NOT 'true'
  AND kind NOT IN ('comment', 'system', 'event')
GROUP BY day;

-- Events (kind "event"): the title is the text, "start" is "YYYY-MM-DD" (all day) or "YYYY-MM-DDTHH:MM".
events:
SELECT id, day, title, json_extract(fields, '$.start') AS start FROM entry
WHERE kind = 'event' AND (day BETWEEN :fromDay AND :toDay) AND json_extract(fields, '$.deleted') IS NOT 'true'
ORDER BY day, start;

tagCounts:
SELECT json_each.value AS name, COUNT(*) AS uses
FROM entry, json_each(entry.fields)
WHERE json_each.key LIKE 'tag:%' AND json_each.value IS NOT NULL AND json_extract(entry.fields, '$.deleted') IS NOT 'true' AND entry.kind != 'system'
GROUP BY json_each.key
ORDER BY uses DESC, name;

indexEntry:
INSERT INTO entry_search(entry_id, title, body, tags) VALUES (?, ?, ?, ?);

unindexEntry:
DELETE FROM entry_search WHERE entry_id = ?;

clearIndex:
DELETE FROM entry_search;

allEntryIds:
SELECT id FROM entry;

updateAttachments:
UPDATE entry SET attachments = ?, media_count = ?, cover = ?, updated_at = ? WHERE id = ?;

putMedia:
INSERT INTO media(sha256, path, size, mime, origin, uploaded, name, captured_at, last_access_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(sha256) DO UPDATE SET
    origin = CASE WHEN media.origin = 'captured' THEN 'captured' ELSE excluded.origin END,
    last_access_at = excluded.last_access_at;

selectMedia:
SELECT * FROM media WHERE sha256 = ?;

touchMedia:
UPDATE media SET last_access_at = ? WHERE sha256 = ?;

pendingUploads:
SELECT * FROM media WHERE origin = 'captured' AND uploaded = 0 ORDER BY last_access_at;

pendingUploadCount:
SELECT COUNT(*) FROM media WHERE origin = 'captured' AND uploaded = 0;

markUploaded:
UPDATE media SET uploaded = 1, uploaded_at = ? WHERE sha256 = ?;

-- Files the server already holds, least recently viewed first: downloads, and captured files confirmed
-- before :settledBefore (the server's backup job has had time to copy them). Small files (previews) stay.
evictable:
SELECT sha256, path, size FROM media
WHERE size >= :minSize AND (origin = 'downloaded' OR (origin = 'captured' AND uploaded = 1 AND uploaded_at < :settledBefore))
ORDER BY last_access_at;

forgetMedia:
DELETE FROM media WHERE sha256 = ? AND (origin = 'downloaded' OR uploaded = 1);

-- After a server restore the server may lack files it once confirmed; the uploader asks again (dedup makes it cheap).
recheckUploads:
UPDATE media SET uploaded = 0 WHERE origin = 'captured';

updateHead:
UPDATE entry SET head_rev = ?, body = ?, title = ?, preview = ?, updated_at = ? WHERE id = ?;

clearConflicts:
UPDATE entry SET conflict_heads = '[]' WHERE id = ?;

draftCount:
SELECT COUNT(*) FROM draft;

deleteAllEntries:
DELETE FROM entry;

updateFields:
UPDATE entry SET fields = ?, field_clocks = ?, updated_at = ? WHERE id = ?;

selectDraft:
SELECT * FROM draft WHERE entry_id = ?;

upsertDraft:
INSERT INTO draft(entry_id, body, base_rev, updated_at) VALUES (?, ?, ?, ?)
ON CONFLICT(entry_id) DO UPDATE SET body = excluded.body, updated_at = excluded.updated_at;

deleteDraft:
DELETE FROM draft WHERE entry_id = ?;

allDrafts:
SELECT entry_id FROM draft;

rejectedCount:
SELECT COUNT(*) FROM outbox WHERE state = 'rejected';

enqueue:
INSERT INTO outbox(op_id, entry_id, op, created_at) VALUES (?, ?, ?, ?);

pendingOps:
SELECT * FROM outbox WHERE state = 'pending' ORDER BY seq LIMIT ?;

acknowledge:
DELETE FROM outbox WHERE op_id = ? AND state = 'pending';

reject:
UPDATE outbox SET state = 'rejected', last_error = ? WHERE op_id = ?;

pendingCountFor:
SELECT COUNT(*) FROM outbox WHERE entry_id = ? AND state = 'pending';

pendingCount:
SELECT COUNT(*) FROM outbox WHERE state = 'pending';

rejectedOps:
SELECT * FROM outbox WHERE state = 'rejected' ORDER BY seq;

retryRejected:
UPDATE outbox SET state = 'pending', last_error = NULL WHERE state = 'rejected';

getValue:
SELECT value FROM kv WHERE key = ?;

putValue:
INSERT INTO kv(key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value;

deleteValue:
DELETE FROM kv WHERE key = ?;
