<!-- The setups in .tmp/sandbox/in, to click through by hand in a clean Windows. -->
<Configuration>
  <MappedFolders>
    <MappedFolder><HostFolder>C:\projects\Benbow\.tmp\sandbox\in</HostFolder><SandboxFolder>C:\in</SandboxFolder><ReadOnly>true</ReadOnly></MappedFolder>
  </MappedFolders>
  <LogonCommand><Command>explorer C:\in</Command></LogonCommand>
  <MemoryInMB>4096</MemoryInMB>
</Configuration>
